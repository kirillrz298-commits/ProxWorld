# -------------------------------------------------------------
# 🤖 КОНФИГУРАЦИЯ БОТА ТЕХПОДДЕРЖКИ PROXGRIEF MINECRAFT
# -------------------------------------------------------------

# Токен вашего Telegram бота (получить в @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram ID главных администраторов через запятую (узнать свой ID в @userinfobot)
ADMIN_IDS=123456789

# ID группы/чата техподдержки для уведомлений (опционально, если 0 - уведомления идут админам в ЛС)
SUPPORT_CHAT_ID=0

# -------------------------------------------------------------
# 🧠 НАСТРОЙКИ ИИ-ПОМОЩНИКА (API KEY)
# -------------------------------------------------------------
# Подходит любой OpenAI-совместимый ключ (OpenAI, DeepSeek, OpenRouter, Gemini через compat):
AI_API_KEY=YOUR_AI_API_KEY_HERE

# Адрес API (по умолчанию OpenAI, но можно менять на DeepSeek, OpenRouter или Google)
# Примеры:
# OpenAI:      https://api.openai.com/v1
# DeepSeek:    https://api.deepseek.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Google:      https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=https://api.openai.com/v1

# Название модели ИИ
# Примеры: gpt-4o-mini, gpt-4o, deepseek-chat, gemini-1.5-flash
AI_MODEL=gpt-4o-mini

# Включить ИИ-помощника (True / False)
AI_ENABLED=True

# -------------------------------------------------------------
# ⚔️ ИНФОРМАЦИЯ О СЕРВЕРЕ PROXGRIEF
# -------------------------------------------------------------
SERVER_NAME=ProxGrief
SERVER_IP=mc.proxgrief.ru
SERVER_PORT=25565
SERVER_VERSIONS=1.16.5 - 1.20.4
SERVER_SITE=https://proxgrief.ru
SERVER_DONATE_URL=https://proxgrief.ru/donate
SERVER_RULES_URL=https://proxgrief.ru/rules
SERVER_VK_URL=https://vk.com/proxgrief
SERVER_DISCORD_URL=https://discord.gg/proxgrief

